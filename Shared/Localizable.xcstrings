    "Aula+ genkender dine børns ansigter på billeder uden tag. Alt sker på telefonen: intet sendes nogen steder, og andre børns ansigter gemmes ikke.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aula+ recognises your children's faces in untagged photos. It all happens on this phone: nothing is sent anywhere, and other children's faces aren't stored."
          }
        }
      }
    },
